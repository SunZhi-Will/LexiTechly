{
    "manifest_version": 3,
    "default_locale": "zh_TW",
    "name": "__MSG_extName__",
    "version": "1.4.1",
    "description": "__MSG_extDescription__",
    "permissions": [
        "storage",
        "unlimitedStorage",
        "activeTab",
        "scripting",
        "contextMenus",
        "offscreen",
        "alarms",
        "sidePanel"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "commands": {
        "translate-images": {
            "suggested_key": {
                "default": "Alt+Shift+T"
            },
            "description": "__MSG_commandTranslateImages__"
        }
    },
    "cross_origin_embedder_policy": {
        "value": "credentialless"
    },
    "cross_origin_opener_policy": {
        "value": "same-origin"
    },
    "background": {
        "service_worker": "src/scripts/background.ts"
    },
    "action": {
        "default_popup": "src/pages/popup.html",
        "default_icon": {
            "128": "images/logo128.png"
        }
    },
    "side_panel": {
        "default_path": "src/pages/sidepanel.html"
    },
    "icons": {
        "128": "images/logo128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/scripts/content.ts"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "images/logo128.png"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; media-src 'self' blob:;"
    }
}
