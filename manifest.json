{
    "manifest_version": 3,
    "name": "LexiTechly - 智慧英文內容分析",
    "version": "1.4.1",
    "description": "使用 Google Gemini AI 分析英文網頁內容，提供 CEFR 等級評估、單字解析、AI 互動對話與語音發音功能，提升您的英文閱讀與學習體驗！",
    "permissions": [
        "storage",
        "unlimitedStorage",
        "activeTab",
        "scripting",
        "contextMenus",
        "offscreen",
        "alarms"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "commands": {
        "translate-images": {
            "suggested_key": {
                "default": "Alt+Shift+T"
            },
            "description": "翻譯這頁的漫畫圖片（自動翻譯，換頁也會跟著翻）"
        }
    },
    "cross_origin_embedder_policy": {
        "value": "credentialless"
    },
    "cross_origin_opener_policy": {
        "value": "same-origin"
    },
    "background": {
        "service_worker": "src/scripts/background.ts"
    },
    "action": {
        "default_popup": "src/pages/popup.html",
        "default_icon": {
            "128": "images/logo128.png"
        }
    },
    "icons": {
        "128": "images/logo128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/scripts/content.ts"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "images/logo128.png"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; media-src 'self' blob:;"
    }
}
